{
  "name": "it-toolkit",
  "version": "1.0.0",
  "description": "IT Toolkit - Diagnóstico y Mantenimiento",
  "main": "main.js",
  "author": "IT Department",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.empresa.ittoolkit",
    "productName": "IT Toolkit",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "portable": {
      "artifactName": "ITToolkit.exe"
    }
  },
  "dependencies": {
    "axios": "^1.18.1",
    "fast-speedtest-api": "^0.3.2"
  }
}
